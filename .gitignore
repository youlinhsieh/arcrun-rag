# 機敏值不進版控（env.sample 只有 key 名）
.env
# 本機 demo 執行期資料（install.sh 產生；PACKAGE-STAGING「不落 repo」規約）
install/state/
install/logs/
node_modules/
.DS_Store

# arcrun 執行配置（含 instance 指向，不進版控；uncle6-deploy-record §一 的規約補洞）
.arcrun.yaml

# GitHub 公開 mirror 工作目錄(publish-github.sh 產物)
.github-public/

# msix 打包產物（build-msix.sh 生成，不進版控）
collector/cmd/arcrun-app/dist-msix/

# wrangler 本地快取／狀態（部署產物，不進版控）
.wrangler/

# docs-site 建置產物（每次 build 重產，不進版控）
docs-site/dist/
docs-site/deploy/
docs-site/node_modules/
docs-site/.astro/

# Wails 建置產物
collector/cmd/arcrun-app/build/bin/
collector/cmd/arcrun-app/frontend/dist/
collector/cmd/arcrun-app/frontend/node_modules/
collector/cmd/arcrun-app/frontend/wailsjs/

# 打包產物：.app bundle 不進版控，也別讓 Spotlight 把它們當成「裝好的 App」
# （leo 2026-08-05：Launchpad 搜 arc 跑出 4 個 Arcrun，其中兩個是 commit 進 repo 的 v0.0.1 退役 fyne 版）
collector/cmd/**/*.app
